{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "title": "megafloyd skills registry",
  "description": "Maps every skill name mandated by SSOT.md §3E to its command file. Skills are markdown prompt commands loaded from .floyd/commands/ (loader: internal/commands/commands.go). One file may answer to several names per the §3E combining rule.",
  "load_paths": [
    "~/.config/floyd/commands",
    "~/.floyd/commands",
    "<DataDirectory>/commands"
  ],
  "skills": [
    { "name": "btw", "file": "btw.md", "wraps": [], "mechanism": "protocol-only" },
    { "name": "compact", "file": "compact.md", "wraps": ["context_status", "transcript_export", "manage_scratchpad", "summarizer (internal/agent/summarizer.go)"], "mechanism": "wraps-existing" },
    { "name": "context", "file": "context.md", "wraps": ["context_status", "floyd_info"], "mechanism": "wraps-existing" },
    { "name": "rewind", "file": "rewind.md", "wraps": ["session fork (internal/session/fork.go)", "transcript_export", "floyd session"], "mechanism": "wraps-existing" },
    { "name": "branch", "file": "branch.md", "aliases": ["fork"], "wraps": ["session fork (internal/session/fork.go)", "git worktree", "floyd session rename"], "mechanism": "wraps-existing", "combined_with": "fork (synonyms — SSOT §3E)" },
    { "name": "fork", "file": "branch.md", "alias_of": "branch", "wraps": ["session fork (internal/session/fork.go)"], "mechanism": "wraps-existing" },
    { "name": "plan", "file": "plan.md", "wraps": ["project_map", "symbol_index", "list_symbols", "todos"], "mechanism": "workflow-template" },
    { "name": "loop", "file": "loop.md", "wraps": ["/ralph", "/ralph-status", "/ralph-cancel (internal/agent/ralph)"], "mechanism": "wraps-existing" },
    { "name": "remote-control", "file": "remote-control.md", "wraps": ["floyd server", "floyd stats", "workspace (internal/workspace)"], "mechanism": "workflow-template", "note": "phone web surface lands wave 4" },
    { "name": "effort", "file": "effort.md", "wraps": ["reasoning_effort config (internal/config)", "floyd_info"], "mechanism": "wraps-existing" },
    { "name": "fast", "file": "fast.md", "wraps": ["model picker", "reasoning_effort", "parallel_bash"], "mechanism": "workflow-template" },
    { "name": "mcp", "file": "mcp.md", "wraps": ["floyd_info", "list_mcp_resources", "read_mcp_resource", "mcp_task_status"], "mechanism": "wraps-existing" },
    { "name": "doctor", "file": "doctor.md", "wraps": ["floyd_info", "floyd models", "floyd session list", "floyd_logs"], "mechanism": "workflow-template", "note": "floyd doctor CLI lands wave 3" },
    { "name": "bisect", "file": "bisect.md", "wraps": ["bash (git bisect)", "get_active_diff", "job_output"], "mechanism": "workflow-template" },
    { "name": "handoff", "file": "handoff.md", "wraps": ["transcript_export", "session fork", "todos", "write"], "mechanism": "wraps-existing" },
    { "name": "arena", "file": "arena.md", "aliases": ["race"], "wraps": ["swarm coordinator (internal/agent/swarm_coordinator.go: Submit/Await)", "git worktree", "get_active_diff"], "mechanism": "wraps-existing", "combined_with": "race (synonyms — SSOT §3E)" },
    { "name": "race", "file": "arena.md", "alias_of": "arena", "wraps": ["swarm coordinator Submit/Await"], "mechanism": "wraps-existing" },
    { "name": "invariants", "file": "invariants.md", "wraps": ["internal/validation", "bash", "parallel_bash"], "mechanism": "workflow-template" },
    { "name": "redteam", "file": "redteam.md", "wraps": ["failure_mode_enumerator", "bash", "/checkpoint"], "mechanism": "workflow-template" },
    { "name": "shadow", "file": "shadow.md", "wraps": ["bash background jobs", "job_output", "job_kill", "parallel_bash"], "mechanism": "wraps-existing" },
    { "name": "blast-radius", "file": "blast-radius.md", "wraps": ["get_active_diff", "symbol_index", "list_symbols", "project_map", "complexity_estimator", "failure_mode_enumerator"], "mechanism": "wraps-existing" },
    { "name": "freeze", "file": "freeze.md", "wraps": ["permission profiles (internal/permission/profile.go: LoadProfiles/SaveProfiles)", "bash"], "mechanism": "wraps-existing" },
    { "name": "thaw", "file": "thaw.md", "wraps": ["permission profiles (internal/permission/profile.go: SaveProfile)", "glob"], "mechanism": "wraps-existing" },
    { "name": "checkpoint", "file": "checkpoint.md", "wraps": ["session fork", "get_active_diff", "todos", "write"], "mechanism": "wraps-existing" },
    { "name": "restore", "file": "restore.md", "wraps": ["floyd session show", "todos", "view"], "mechanism": "wraps-existing", "note": "inverse of checkpoint; separate file per SSOT §3E" },
    { "name": "spec-sync", "file": "spec-sync.md", "wraps": ["grep", "symbol_index", "list_symbols", "project_map", "edit"], "mechanism": "workflow-template" },
    { "name": "route", "file": "route.md", "wraps": ["complexity_estimator", "task agent (internal/agent/coordinator.go)", "parallel_bash", "mcp_task_status"], "mechanism": "wraps-existing" },
    { "name": "retro", "file": "retro.md", "wraps": ["transcript_export", "write"], "mechanism": "workflow-template" },
    { "name": "contract", "file": "contract.md", "wraps": ["bash", "write"], "mechanism": "workflow-template", "note": "deep Go plumbing pending; JSON contract template under .harness/contracts/" },
    { "name": "prove", "file": "prove.md", "wraps": ["bash", "shasum", "write"], "mechanism": "workflow-template", "note": "deep Go plumbing pending; proof records under .harness/proofs/" },
    { "name": "recover", "file": "recover.md", "wraps": ["floyd session list/show", "/ralph-status", "floyd_logs", "run markers (internal/agent/run_marker.go)", "transcript_export", "get_active_diff"], "mechanism": "wraps-existing" },
    { "name": "budget", "file": "budget.md", "wraps": ["TokenBudget (internal/agent/budget.go)", "context_status", "manage_scratchpad", "mcp_task_status"], "mechanism": "wraps-existing" },
    { "name": "drift", "file": "drift.md", "wraps": ["grep", "glob", "get_active_diff", "git log", "edit"], "mechanism": "workflow-template" },
    { "name": "reproduce", "file": "reproduce.md", "wraps": ["bash", "write"], "mechanism": "workflow-template" },
    { "name": "replay", "file": "replay.md", "wraps": ["transcript_export", "bash", "parallel_bash", "floyd session show"], "mechanism": "workflow-template", "note": "deep record/replay plumbing pending" },
    { "name": "why", "file": "why.md", "wraps": ["git log", "transcript_export", "query_floyd_archive"], "mechanism": "workflow-template", "note": "deep rationale records pending; transcripts+git today" },
    { "name": "compare", "file": "compare.md", "wraps": ["git diff --no-index", "get_active_diff", "complexity_estimator", "symbol_index", "transcript_export"], "mechanism": "wraps-existing" },
    { "name": "promote", "file": "promote.md", "wraps": ["apply_patch", "smart_replace", "git worktree", "todos"], "mechanism": "workflow-template" },
    { "name": "learn", "file": "learn.md", "wraps": ["write (.floyd/commands/<name>.md)", "edit (AGENTS.md)"], "mechanism": "wraps-existing" },
    { "name": "test", "file": "test.md", "wraps": ["task test", "go test -race", "job_output"], "mechanism": "workflow-template" },
    { "name": "lint", "file": "lint.md", "wraps": ["task fmt (gofumpt)", "task lint (golangci-lint)", "task lint:log"], "mechanism": "workflow-template" },
    { "name": "security-review", "file": "security-review.md", "wraps": ["get_active_diff", "project_map", "grep", "failure_mode_enumerator"], "mechanism": "workflow-template" },
    { "name": "debug", "file": "debug.md", "wraps": ["floyd_logs", "grep", "symbol_index", "list_symbols", "bash"], "mechanism": "workflow-template" }
  ]
}
