#!/usr/bin/env bash
# MegaFloyd launcher.
#
# Exports the MEGAFLOYD_* namespace, mirrors the FLOYD_* variables the chassis
# reads, creates the home layout, and execs the binary. See
# docs/megafloyd-namespace.md.
#
# Override the binary with MEGAFLOYD_BIN=/path/to/megafloyd.
set -euo pipefail

APP=megafloyd
DISPLAY_NAME=MegaFloyd

# shellcheck disable=SC1007 # CDPATH= is an env assignment, not an empty value.
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

MEGAFLOYD_HOME=${MEGAFLOYD_HOME:-"$HOME/.megafloyd"}

# Canonical paths are independent of inherited parent-harness mirrors.
MEGAFLOYD_CONFIG_DIR=${MEGAFLOYD_CONFIG_DIR:-"$MEGAFLOYD_HOME/config"}
MEGAFLOYD_DATA_DIR=${MEGAFLOYD_DATA_DIR:-"$MEGAFLOYD_HOME/data"}
MEGAFLOYD_CACHE_DIR=${MEGAFLOYD_CACHE_DIR:-"$MEGAFLOYD_HOME/cache"}

mkdir -p "$MEGAFLOYD_HOME" \
	"$MEGAFLOYD_CONFIG_DIR" \
	"$MEGAFLOYD_DATA_DIR" \
	"$MEGAFLOYD_CACHE_DIR" \
	"$MEGAFLOYD_HOME/state" \
	"$MEGAFLOYD_HOME/logs"

export MEGAFLOYD_HOME MEGAFLOYD_CONFIG_DIR MEGAFLOYD_DATA_DIR MEGAFLOYD_CACHE_DIR
export MEGAFLOYD_ACTIVE=1

# Compatibility mirrors, derived from the resolved values above.
export FLOYD_GLOBAL_CONFIG=$MEGAFLOYD_CONFIG_DIR
export FLOYD_GLOBAL_DATA=$MEGAFLOYD_DATA_DIR
export FLOYD_CACHE_DIR=$MEGAFLOYD_CACHE_DIR

if [ -n "${MEGAFLOYD_IDENTITY:-}" ]; then
	export FLOYD_IDENTITY=$MEGAFLOYD_IDENTITY
fi
if [ -n "${MEGAFLOYD_PROFILE:-}" ]; then
	export FLOYD_PROFILE=$MEGAFLOYD_PROFILE
fi
if [ -n "${MEGAFLOYD_SKILLS_DIR:-}" ]; then
	export FLOYD_SKILLS_DIR=$MEGAFLOYD_SKILLS_DIR
fi

# Resolve the binary. MEGAFLOYD_BIN wins; otherwise look beside the script
# (repo checkout), in the user install location, then on PATH. A candidate
# that is this script itself is skipped so exec cannot loop.
REAL=""
consider() {
	if [ -n "$1" ] && [ -x "$1" ] && ! [ "$1" -ef "$0" ]; then
		REAL=$1
		return 0
	fi
	return 1
}

if [ -n "${MEGAFLOYD_BIN:-}" ]; then
	consider "$MEGAFLOYD_BIN" || {
		printf '%s: MEGAFLOYD_BIN is not executable: %s\n' "$DISPLAY_NAME" "$MEGAFLOYD_BIN" >&2
		exit 127
	}
fi

if [ -z "$REAL" ]; then
	consider "$SELF_DIR/../dist/$APP" || true
fi
if [ -z "$REAL" ]; then
	consider "$SELF_DIR/$APP" || true
fi
if [ -z "$REAL" ]; then
	consider "$HOME/.local/bin/$APP" || true
fi
if [ -z "$REAL" ]; then
	PATH_BIN=$(command -v "$APP" 2>/dev/null || true)
	consider "$PATH_BIN" || true
fi

if [ -z "$REAL" ]; then
	cat >&2 <<EOF
$DISPLAY_NAME: cannot find the $APP binary.

Build it first:
  cd floyd-go && go build -o ../dist/$APP .

Or point at an existing build:
  MEGAFLOYD_BIN=/path/to/$APP $APP

Home: $MEGAFLOYD_HOME
EOF
	exit 127
fi

# The Go runtime resolves workspace state in the current account's private home,
# honoring this account's explicit workspace mapping when one is configured.
# An explicit --data-dir argument is passed through unchanged.
exec -a "$APP" "$REAL" "$@"
